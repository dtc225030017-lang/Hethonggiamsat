# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project
# across various editors and IDEs.
# More information: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C and C++ Source / Headers
[*.{c,h,cpp,hpp,cc,cxx,hxx,ino}]
indent_style = space
indent_size = 4

# CMake files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

# YAML and JSON configs
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4
end_of_line = lf

# Windows batch files
[*.{bat,cmd}]
indent_style = space
indent_size = 4
end_of_line = crlf

# INI files
[*.ini]
indent_style = space
indent_size = 4
